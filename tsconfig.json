{
  "compilerOptions": {
    "module": "NodeNext",
    "esModuleInterop": true,
    "target": "es2022",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "NodeNext",
    "sourceMap": true,
    "outDir": "./build"
  },
  "include": [
    "services/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
