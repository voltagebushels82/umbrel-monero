{
  "name": "umbrel-middleware",
  "version": "0.4.0",
  "description": "Middleware for Umbrel Node",
  "author": "Deverick",
  "type": "module",
  "scripts": {
    "lint": "node scripts/check-syntax.js",
    "build": "tsc",
    "start": "node ./bin/www.js",
    "start:server:dev": "node --env-file-if-exists=.env --watch ./bin/www.js",
    "start:ui:dev": "cd ui && npm run serve:dev",
    "start:all:dev": "npm-run-all --parallel start:server:dev start:ui:dev",
    "install:ui": "npm ci --prefix ui",
    "build:ui": "cd ui && npm run build",
    "serve:ui": "cd ui && npm run serve",
    "test": "npm run build && node --test test/*.test.js test/endpoints/*.js test/endpoints/v1/monerod/*.js test/unit/*.js",
    "coverage": "npm run build && node --experimental-test-coverage --test test/*.test.js test/endpoints/*.js test/endpoints/v1/monerod/*.js test/unit/*.js",
    "test:ui": "playwright test",
    "test:docker:ui": "playwright test --config playwright.docker.config.js",
    "test:anonymity": "node scripts/test-anonymity.js"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "camelize-keys": "^1.0.0",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "digest-fetch": "^3.1.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "http-auth": "^4.2.1",
    "monero-ts": "^0.11.22",
    "morgan": "^1.12.1",
    "undici": "^8.12.4",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "npm-run-all2": "^9.0.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
