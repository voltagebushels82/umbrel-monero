PORT=8889
MONERO_HOST=127.0.0.1
MONERO_RPC_PORT=18081
MONERO_RPC_USER=monero
MONERO_RPC_PASSWORD=monero
MONERO_TOR=false
DEVICE_DOMAIN_NAME=localhost
JSON_STORE_FILE=./data/monero-config.json
MONERO_CONF_FILE=./data/monero/bitmonero.conf
# Tor deployments must configure real services before enabling Tor:
# TOR_PROXY_IP=127.0.0.1
# TOR_PROXY_PORT=9050
# MONERO_P2P_HIDDEN_SERVICE=<56-character-v3-hostname>.onion
# I2P_DAEMON_IP=127.0.0.1
# I2P_DAEMON_PORT=4447
# MONERO_I2P_HIDDEN_SERVICE=<52-character-destination>.b32.i2p
# MONERO_RESTRICTED_RPC_USER=wallet
# MONERO_RESTRICTED_RPC_PASSWORD=<separate-wallet-password>
